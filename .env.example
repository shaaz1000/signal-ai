# ── Database ────────────────────────────────────────────────────────────────
# Postgres connection string (Supabase: use the pooler URL). Leave unset to use
# the embedded PGlite store in ./.data/pglite (local development and the
# zero-infrastructure GitHub Actions mode).
DATABASE_URL=
# Directory for the embedded store when DATABASE_URL is unset.
PGLITE_DIR=.data/pglite

# ── Source credentials (all optional, all server-side only) ────────────────
# GitHub token raises search limits from 10 to 30 requests/min and core limits
# from 60 to 5000 requests/hour. In GitHub Actions the built-in token is used.
GITHUB_TOKEN=
# Reddit is only queried through its official OAuth API. Without these the
# Reddit source reports "not configured" and is skipped.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── AI summarisation ───────────────────────────────────────────────────────
# extractive (default, no key needed) | anthropic | openai
AI_PROVIDER=extractive
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=
# Maximum discoveries sent to the model per run (cost guard).
AI_MAX_ITEMS_PER_RUN=40

# ── App ────────────────────────────────────────────────────────────────────
# Public base URL, used for canonical links and the outbound User-Agent.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
