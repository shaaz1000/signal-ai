# ── Database ────────────────────────────────────────────────────────────────
# Postgres connection string (Supabase: use the pooler URL). Leave unset to use
# the embedded PGlite store in ./.data/pglite (local development and the
# zero-infrastructure GitHub Actions mode).
DATABASE_URL=
# Directory for the embedded store when DATABASE_URL is unset.
PGLITE_DIR=.data/pglite

# ── Source credentials (all optional, all server-side only) ────────────────
# GitHub token raises search limits from 10 to 30 requests/min and core limits
# from 60 to 5000 requests/hour. In GitHub Actions the built-in token is used.
GITHUB_TOKEN=
# Reddit is only queried through its official OAuth API. Without these the
# Reddit source reports "not configured" and is skipped.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# ── AI summarisation ───────────────────────────────────────────────────────
# extractive (default, no key needed) | anthropic | openai
AI_PROVIDER=extractive
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=
# Maximum discoveries sent to the model per run (cost guard).
AI_MAX_ITEMS_PER_RUN=40

# ── App ────────────────────────────────────────────────────────────────────
# Public base URL, used for canonical links and the outbound User-Agent.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Protected generation and translation (lib/security, lib/translation) ───
# BEGIN protected-generation
# Signs session cookies and salts address hashes. REQUIRED for any paid work:
# at least 32 random characters (e.g. `openssl rand -base64 48`). There is no
# default. Without it nobody can sign in and every new generation or
# translation is refused; stored content stays readable.
AUTH_SECRET=
# Kill switch. `true` refuses all new paid work at once. The same switch can be
# flipped at runtime: `npm run admin -- flag:set generation_disabled true`.
GENERATION_DISABLED=false

# Translation provider: nvidia | openai | anthropic. Unset = translation off.
TRANSLATION_PROVIDER=
# NVIDIA NIM (OpenAI-compatible). The model is required and has no default:
# choose one that is actually a translation-capable model.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TRANSLATION_MODEL=
# OpenAI-compatible endpoint (uses OPENAI_API_KEY above). Model required.
OPENAI_TRANSLATION_MODEL=
OPENAI_BASE_URL=
# Anthropic uses ANTHROPIC_API_KEY and ANTHROPIC_MODEL above.
# Comma-separated language codes to offer (subset of en,hi,hinglish,mr,ar,fr,es,de). Unset = all.
TRANSLATION_LANGUAGES=

# Limits. A "unit" is one character sent to or received from a provider.
# Every value must be a whole number; an invalid value disables paid work
# rather than silently loosening a limit. Shown: the defaults.
LIMIT_FREE_TRANSLATION_PER_HOUR=10
LIMIT_FREE_EXPLANATION_PER_HOUR=5
LIMIT_FREE_STORY_PER_DAY=3
LIMIT_FREE_DRAFT_PER_DAY=10
LIMIT_FREE_CONCURRENT_JOBS=2
LIMIT_FREE_DAILY_UNITS=60000
LIMIT_PRO_TRANSLATION_PER_HOUR=100
LIMIT_PRO_EXPLANATION_PER_HOUR=40
LIMIT_PRO_STORY_PER_DAY=20
LIMIT_PRO_DRAFT_PER_DAY=60
LIMIT_PRO_CONCURRENT_JOBS=4
LIMIT_PRO_DAILY_UNITS=600000
# Units per UTC day for the whole deployment, and for any one provider.
GENERATION_GLOBAL_DAILY_UNITS=2000000
GENERATION_PROVIDER_DAILY_UNITS=2000000
# Money per unit, for the `cost` column of usage reports only (0 to 1).
GENERATION_UNIT_COST=0
# Hard ceiling on one provider operation, in milliseconds.
GENERATION_TIMEOUT_MS=45000
# Largest source text accepted per kind, in characters.
GENERATION_MAX_INPUT_TRANSLATION=8000
GENERATION_MAX_INPUT_EXPLANATION=12000
GENERATION_MAX_INPUT_STORY=12000
GENERATION_MAX_INPUT_DRAFT=12000
# Requests per address per hour above which an abuse signal is recorded (never blocks).
GENERATION_IP_HOURLY_REQUESTS=120
# Cooldown triggers: denials in 10 minutes, distinct uncached requests in 2 minutes; cooldown length.
ABUSE_DENIALS=20
ABUSE_DISTINCT_UNCACHED=8
ABUSE_COOLDOWN_MINUTES=15
# END protected-generation
